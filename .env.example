# Copy this file to `.env.local` and fill in ONE of the email notification options below.
# All stock bookings will be automatically emailed to MUTHUINTERNATIONALPVTLTD@GMAIL.COM.

# ── OPTION 1 (Recommended — 100% Free using your own Gmail via Google Apps Script) ──
# Paste the deployed Google Apps Script Web App URL here:
# BOOKING_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# ── OPTION 2 (Resend API — Free 3,000 emails/month) ──
# Sign up at https://resend.com with MUTHUINTERNATIONALPVTLTD@GMAIL.COM and paste your API key:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=Kids Korner Bookings <onboarding@resend.dev>

# ── OPTION 3 (Brevo API — Free 300 emails/day to any recipient) ──
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BREVO_SENDER_EMAIL=MUTHUINTERNATIONALPVTLTD@GMAIL.COM

# ── OPTION 4 (Web3Forms — Free access key) ──
# WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

